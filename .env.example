# Copy this file to ".env" and fill in your own values. NEVER commit ".env" to GitHub.

# MongoDB connection string. Local: mongodb://localhost:27017/campusconnect
# Atlas (cloud): mongodb+srv://USER:URL_ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusconnect

# Port the API listens on (Render sets this automatically)
PORT=8080

# OAuth 2.0 Web client ID from Google Cloud (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=

# Comma-separated list of emails allowed to act as administrators
ADMIN_EMAILS=admin.rajalakshmi.edu.in@gmail.com

# Secret password needed to create an admin account. Use a long random value, e.g.: openssl rand -base64 24
ADMIN_REGISTRATION_KEY=change-me-to-a-long-random-value

# Websites allowed to call the API (your Vercel site and local test pages)
CORS_ALLOWED_ORIGINS=https://campus-connect-1-mu.vercel.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# How many hours a login stays valid
SESSION_HOURS=6

# Time zone used for "upcoming" and "past" events
APP_TIMEZONE=Asia/Kolkata
